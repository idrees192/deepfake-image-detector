# Recommend Git LFS for large binary model files
*.h5 filter=lfs diff=lfs merge=lfs -text
*.keras filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
# Auto detect text files and perform LF normalization
* text=auto

# Model files (binary)
*.keras binary
*.h5 binary
*.weights.h5 binary

# Python files
*.py text diff=python

# Configuration files
*.json text
*.txt text
*.md text

# Ignore all files in virtual environments
venv/ -text
venv310/ -text
